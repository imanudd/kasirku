        <Component class="javax.swing.JLabel" name="jLabel13">
          <Properties>
            <Property name="text" type="java.lang.String" value="&lt;html&gt;&#xa;  &lt;style&gt;&#xa;      body {&#xa;        text-align: center;&#xa;      }&#xa;      ul {&#xa;        text-align: left;&#xa;        list-style-position: inside;&#xa;      }&#xa;    &lt;/style&gt;&#xa;  &lt;body&gt;&#xa;    &lt;h2&gt; PETSTOP Desktop Application &lt;/h2&gt;&#xa;    &#xa;    &lt;h3&gt; Entities: &lt;/h3&gt;&#xa;    &#xa;    &lt;ul&gt;&#xa;      &lt;li&gt;&#xa;        &lt;strong&gt; Cashiers: &lt;/strong&gt;&#xa;        Manage cashier details, including name, contact information, and responsibilities.&#xa;      &lt;/li&gt;&#xa;      &#xa;      &lt;li&gt;&#xa;        &lt;strong&gt; Transactions: &lt;/strong&gt;&#xa;        Record and track sales transactions, providing a detailed overview of purchases.&#xa;      &lt;/li&gt;&#xa;      &#xa;      &lt;li&gt;&#xa;        &lt;strong&gt; Stocks: &lt;/strong&gt;&#xa;        Efficiently manage and monitor inventory levels, ensuring products are well-stocked.&#xa;      &lt;/li&gt;&#xa;      &#xa;      &lt;li&gt;&#xa;        &lt;strong&gt; Suppliers: &lt;/strong&gt;&#xa;        Maintain a list of suppliers with relevant information for streamlined inventory replenishment.&#xa;      &lt;/li&gt;&#xa;    &lt;/ul&gt;&#xa;&#xa;    &lt;h3&gt; Key Features: &lt;/h3&gt;&#xa;&#xa;    &lt;ul&gt;&#xa;      &lt;li&gt;&#xa;        &lt;strong&gt; Cashier Management: &lt;/strong&gt;&#xa;        Add, modify, and delete cashiers for effective team management.&#xa;      &lt;/li&gt;&#xa;&#xa;      &lt;li&gt;&#xa;        &lt;strong&gt; Transaction Recording: &lt;/strong&gt;&#xa;        Record sales transactions, providing a comprehensive overview of sales activities.&#xa;      &lt;/li&gt;&#xa;&#xa;      &lt;li&gt;&#xa;        &lt;strong&gt; Stock Management: &lt;/strong&gt;&#xa;        Keep track of inventory levels, receive alerts for low stock, and manage stock details.&#xa;      &lt;/li&gt;&#xa;&#xa;      &lt;li&gt;&#xa;        &lt;strong&gt; Supplier Information: &lt;/strong&gt;&#xa;        Maintain a list of suppliers, including contact details, for efficient inventory replenishment.&#xa;      &lt;/li&gt;&#xa;    &lt;/ul&gt;&#xa;  &lt;/body&gt;&#xa;&lt;/html&gt;&#xa;"/>
            <Property name="verticalAlignment" type="int" value="1"/>
          </Properties>
          <Constraints>
            <Constraint layoutClass="org.netbeans.modules.form.compat2.layouts.DesignAbsoluteLayout" value="org.netbeans.modules.form.compat2.layouts.DesignAbsoluteLayout$AbsoluteConstraintsDescription">
              <AbsoluteConstraints x="170" y="30" width="740" height="280"/>
            </Constraint>
          </Constraints>
        </Component>
